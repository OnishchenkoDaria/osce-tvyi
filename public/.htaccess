# Single-page landing: no routing fallback needed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets can be cached for a long time
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must always be revalidated so new deploys show up
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
